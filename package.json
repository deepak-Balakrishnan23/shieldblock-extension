{
  "name": "shieldblock-extension",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-browser ad blocking extension with YouTube-focused hybrid blocking.",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:chrome": "node ./scripts/build.mjs chrome",
    "build:firefox": "node ./scripts/build.mjs firefox",
    "lint": "eslint \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\" \"scripts/**/*.{js,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.53.2",
    "@types/chrome": "^0.0.327",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.0.10",
    "esbuild": "^0.25.3",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
