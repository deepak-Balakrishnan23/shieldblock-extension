{
  "manifest_version": 3,
  "name": "ShieldBlock AI \u2013 Ad Blocker",
  "version": "2.5.0",
  "description": "Adaptive AI ad blocker with imported filter lists, domain-smart learning, cosmetic filters, and phishing guard.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.linkedin.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "patterns",
        "enabled": true,
        "path": "rules/patterns.json"
      },
      {
        "id": "popups",
        "enabled": true,
        "path": "rules/popups.json"
      },
      {
        "id": "youtube",
        "enabled": true,
        "path": "rules/youtube.json"
      },
      {
        "id": "malware",
        "enabled": true,
        "path": "rules/malware.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js",
        "cosmetic.js",
        "ai-heuristic.js",
        "ai-ml.js",
        "ai-phishing.js",
        "annoyances.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model/ad_classifier.json"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
