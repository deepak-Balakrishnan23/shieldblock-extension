{
  "manifest_version": 3,
  "name": "ShieldBlock AI",
  "version": "3.0.1",
  "description": "AI-powered blocker for ads, trackers, malware and YouTube ads, with built-in SponsorBlock. On-device filtering, fast and private.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scriptlets/google-tag.js",
        "scriptlets/no-sourcepoint.js",
        "scriptlets/no-admiral.js",
        "scriptlets/no-confiant.js",
        "scriptlets/prevent-setTimeout.js",
        "scriptlets/prevent-addEventListener.js",
        "scriptlets/set-constant.js",
        "scriptlets/abort-on-property-read.js",
        "scriptlets/no-xhr-if.js",
        "scriptlets/no-fetch-if.js",
        "scriptlets/yt-player.js",
        "scriptlets/index.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cosmetic.js",
        "content.js",
        "sponsorblock.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "heuristic.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads-core",
        "enabled": true,
        "path": "rules/ads-core.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      },
      {
        "id": "youtube",
        "enabled": true,
        "path": "rules/youtube-network.json"
      },
      {
        "id": "security",
        "enabled": true,
        "path": "rules/security.json"
      },
      {
        "id": "gen-exc-01",
        "enabled": true,
        "path": "rules/generated/exc-01.json"
      },
      {
        "id": "gen-exc-02",
        "enabled": true,
        "path": "rules/generated/exc-02.json"
      },
      {
        "id": "gen-core-01",
        "enabled": true,
        "path": "rules/generated/core-01.json"
      },
      {
        "id": "gen-core-02",
        "enabled": true,
        "path": "rules/generated/core-02.json"
      },
      {
        "id": "gen-core-03",
        "enabled": true,
        "path": "rules/generated/core-03.json"
      },
      {
